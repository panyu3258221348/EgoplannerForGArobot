<launch>
  <arg name="map_size_x" value="20.0"/>
  <arg name="map_size_y" value="20.0"/>
  <arg name="map_size_z" value="5.0"/>

  <!-- EGO planner -->
  <include file="$(find plan_manage)/launch/advanced_param.xml">
    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="odometry_topic" value="/visual_slam/odom"/>
    <arg name="camera_pose_topic" value="/unused"/>
    <arg name="depth_topic" value="/unused"/>
    <arg name="cloud_topic" value="/map_generator/global_cloud"/>
    <arg name="cx" value="320"/><arg name="cy" value="240"/>
    <arg name="fx" value="337"/><arg name="fy" value="337"/>
    <arg name="max_vel" value="1.0"/>
    <arg name="max_acc" value="2.0"/>
    <arg name="planning_horizon" value="5.0"/>
    <arg name="flight_type" value="1"/>
    <arg name="point_num" value="1"/>
    <arg name="point0_x" value="0"/><arg name="point0_y" value="0"/><arg name="point0_z" value="0"/>
    <arg name="point1_x" value="0"/><arg name="point1_y" value="0"/><arg name="point1_z" value="0"/>
    <arg name="point2_x" value="0"/><arg name="point2_y" value="0"/><arg name="point2_z" value="0"/>
    <arg name="point3_x" value="0"/><arg name="point3_y" value="0"/><arg name="point3_z" value="0"/>
    <arg name="point4_x" value="0"/><arg name="point4_y" value="0"/><arg name="point4_z" value="0"/>
  </include>

  <!-- traj server -->
  <node pkg="plan_manage" name="traj_server" type="traj_server" output="screen">
    <remap from="/position_cmd" to="planning/pos_cmd"/>
    <remap from="/odom_world" to="/visual_slam/odom"/>
  </node>

  <!-- waypoint -->
  <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator" output="screen">
    <remap from="~odom" to="/visual_slam/odom"/>
    <remap from="~goal" to="/move_base_simple/goal"/>
    <param name="waypoint_type" value="manual-lonely-waypoint"/>
  </node>

  <!-- map generator -->
  <node pkg="map_generator" name="random_forest" type="random_forest" output="screen">
    <param name="init_state_x" value="-2"/>
    <param name="init_state_y" value="0"/>
    <param name="map/x_size" value="$(arg map_size_x)"/>
    <param name="map/y_size" value="$(arg map_size_y)"/>
    <param name="map/z_size" value="$(arg map_size_z)"/>
    <param name="map/resolution" value="0.1"/>
    <param name="map/obs_num" value="80"/>
    <param name="map/circle_num" value="0"/>
    <param name="ObstacleShape/lower_rad" value="0.8"/>
    <param name="ObstacleShape/upper_rad" value="1.2"/>
    <param name="ObstacleShape/lower_hei" value="0.8"/>
    <param name="ObstacleShape/upper_hei" value="1.25"/>
    <param name="ObstacleShape/seed" value="-1"/>
    <remap from="~odometry" to="/visual_slam/odom"/>
    <remap from="~global_map" to="/map_generator/global_cloud"/>
  </node>

  <!-- TABV controller: ground -> cmd_vel, air -> position_cmd -->
  <node pkg="tabv_control" name="tabv_controller" type="tabv_controller" output="screen">
    <param name="ground_thresh" value="0.3"/>
  </node>

  <!-- ground simulator: cmd_vel -> odom -->
  <node pkg="tabv_control" name="ground_sim" type="ground_sim" output="screen">
    <param name="dt" value="0.02"/>
  </node>

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find plan_manage)/config/traj.rviz"/>

</launch>
